# Copy this file to .env and enter credentials LOCALLY. Do not commit .env.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.1-flash-lite

# PayPal REST app credentials for the Sandbox environment ONLY.
PAYPAL_CLIENT_ID=your-sandbox-rest-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-rest-client-secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
APP_URL=http://localhost:8501
BUDGETPILOT_ENABLE_PAYPAL_SANDBOX=0
