# Copy to .env and fill in locally. NEVER commit real credentials.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.1-flash-lite

# PayPal Sandbox REST API credentials; keep these in .env only.
PAYPAL_CLIENT_ID=your-sandbox-rest-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-rest-client-secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
APP_URL=http://localhost:8501
# Set to 1 only for your manually verified Sandbox demo.
BUDGETPILOT_ENABLE_PAYPAL_SANDBOX=0
